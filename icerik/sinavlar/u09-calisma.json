nde", "arkada"], "dogru": 0}, {"id": "e1_7", "soru": "noir (un manteau ___)", "secenekler": ["önde", "arkada"], "dogru": 1}, {"id": "e1_8", "soru": "joli (une ___ maison)", "secenekler": ["önde", "arkada"], "dogru": 0}, {"id": "e1_9", "soru": "sympathique (un homme ___)", "secenekler": ["önde", "arkada"], "dogru": 1}, {"id": "e1_10", "soru": "vieux (une ___ voiture)", "secenekler": ["önde", "arkada"], "dogru": 0}]}, {"id": "e2", "tip": "kisa", "ad": "E2. Sıfatı yerine koy", "tr": "Fransızca yaz", "talimat": "Sıfatı doğru yere ve doğru biçimde koy. Ünlüden önce bel, nouvel, vieil.", "sorular": [{"id": "e2_1", "soru": "kırmızı bir elbise", "dogru": ["une robe rouge"]}, {"id": "e2_2", "soru": "küçük bir şehir", "dogru": ["une petite ville"]}, {"id": "e2_3", "soru": "eski bir arkadaş (erkek)", "dogru": ["un vieil ami"]}, {"id": "e2_4", "soru": "yeni bir daire", "dogru": ["un nouvel appartement"]}, {"id": "e2_5", "soru": "yakışıklı bir adam", "dogru": ["un bel homme"]}, {"id": "e2_6", "soru": "güzel, gri bir palto", "dogru": ["un beau manteau gris"]}, {"id": "e2_7", "soru": "Kanadalı bir arkadaş (kadın)", "dogru": ["une amie canadienne"]}, {"id": "e2_8", "soru": "iyi bir fikir", "dogru": ["une bonne idée"]}]}, {"id": "f1", "tip": "kisa", "ad": "F1. Kıyafetler", "tr": "Fransızca yaz", "talimat": "Artikeliyle yaz (le / la / les).", "sorular": [{"id": "f1_1", "soru": "palto", "dogru": ["le manteau"]}, {"id": "f1_2", "soru": "etek", "dogru": ["la jupe"]}, {"id": "f1_3", "soru": "gömlek", "dogru": ["la chemise"]}, {"id": "f1_4", "soru": "kazak", "dogru": ["le pull"]}, {"id": "f1_5", "soru": "ayakkabı (çoğul)", "dogru": ["les chaussures"]}, {"id": "f1_6", "soru": "çorap (çoğul)", "dogru": ["les chaussettes"]}, {"id": "f1_7", "soru": "eldiven (çoğul)", "dogru": ["les gants"]}, {"id": "f1_8", "soru": "atkı", "dogru": ["l'écharpe"]}, {"id": "f1_9", "soru": "bere (Québec)", "dogru": ["la tuque", "le bonnet"]}, {"id": "f1_10", "soru": "elbise", "dogru": ["la robe"]}, {"id": "f1_11", "soru": "pantolon", "dogru": ["le pantalon"]}, {"id": "f1_12", "soru": "çizme (çoğul)", "dogru": ["les bottes"]}]}, {"id": "f2", "tip": "kisa", "ad": "F2. Kıyafet + renk", "tr": "Fransızca yaz", "talimat": "Renk arkada ve uyumlu. marron, orange değişmez.", "sorular": [{"id": "f2_1", "soru": "beyaz bir gömlek", "dogru": ["une chemise blanche"]}, {"id": "f2_2", "soru": "siyah bir pantolon", "dogru": ["un pantalon noir"]}, {"id": "f2_3", "soru": "yeşil bir etek", "dogru": ["une jupe verte"]}, {"id": "f2_4", "soru": "gri eldivenler", "dogru": ["des gants gris"]}, {"id": "f2_5", "soru": "kahverengi ayakkabılar", "dogru": ["des chaussures marron"]}, {"id": "f2_6", "soru": "mavi bir kazak", "dogru": ["un pull bleu"]}, {"id": "f2_7", "soru": "mor bir elbise", "dogru": ["une robe violette"]}, {"id": "f2_8", "soru": "beyaz çoraplar", "dogru": ["des chaussettes blanches"]}, {"id": "f2_9", "soru": "açık mavi bir gömlek", "dogru": ["une chemise bleu clair"]}, {"id": "f2_10", "soru": "turuncu bir ceket", "dogru": ["une veste orange"]}]}, {"id": "f3", "tip": "kisa", "ad": "F3. porter mı, mettre mi?", "tr": "Seç", "talimat": "porter = üstünde (durum); mettre = giyinmek (eylem).", "sorular": [{"id": "f3_1", "soru": "Aujourd'hui, elle ___ une robe noire.", "secenekler": ["porte", "met"], "dogru": 0}, {"id": "f3_2", "soru": "Il fait froid : je ___ mon manteau.", "secenekler": ["porte", "mets"], "dogru": 1}, {"id": "f3_3", "soru": "Mets ta tuque ! = Bereni ___!", "secenekler": ["taşı", "giy"], "dogru": 1}, {"id": "f3_4", "soru": "Les enfants ___ leurs bottes avant de sortir.", "secenekler": ["portent", "mettent"], "dogru": 1}, {"id": "f3_5", "soru": "Mon père ___ toujours une cravate.", "secenekler": ["porte", "met"], "dogru": 0, "aciklama": "her zaman üstünde: durum"}, {"id": "f3_6", "soru": "nous ___ (mettre)", "dogru": ["mettons"]}, {"id": "f3_7", "soru": "ils ___ (mettre)", "dogru": ["mettent"]}, {"id": "f3_8", "soru": "Botlarımı çıkarıyorum.", "dogru": ["J'enlève mes bottes."]}]}, {"id": "g", "tip": "kisa", "ad": "G. Karşılaştırma", "tr": "Fransızca yaz", "talimat": "plus / moins / aussi + sıfat + que. Sıfat özneye uyar. bon → meilleur.", "sorular": [{"id": "g1", "soru": "Ben kız kardeşimden daha uzunum. (İlknur)", "dogru": ["Je suis plus grande que ma sœur."]}, {"id": "g2", "soru": "O (erkek) benden daha genç.", "dogru": ["Il est plus jeune que moi."]}, {"id": "g3", "soru": "Bu elbise öbüründen daha ucuz.", "dogru": ["Cette robe est moins chère que l'autre."]}, {"id": "g4", "soru": "Senin kadar yorgunum. (İlknur)", "dogru": ["Je suis aussi fatiguée que toi."]}, {"id": "g5", "soru": "Bu pasta daha iyi.", "dogru": ["Ce gâteau est meilleur."]}, {"id": "g6", "soru": "en iyi arkadaşım (kadın)", "dogru": ["ma meilleure amie"]}, {"id": "g7", "soru": "Kanada Türkiye'den daha büyük.", "dogru": ["Le Canada est plus grand que la Turquie."]}, {"id": "g8", "soru": "Montréal'de kış İstanbul'dan daha soğuk.", "dogru": ["L'hiver à Montréal est plus froid qu'à Istanbul."]}, {"id": "g9", "soru": "Ce restaurant est ___ que l'autre.", "secenekler": ["plus bon", "meilleur"], "dogru": 1, "aciklama": "✗ plus bon"}, {"id": "g10", "soru": "Kızım oğlumdan daha çalışkan.", "dogru": ["Ma fille est plus travailleuse que mon fils."]}]}, {"id": "h", "tip": "kisa", "ad": "H. Mağazada ve kışın", "tr": "Karışık", "talimat": "très = çok (nötr), trop = fazla (sorun).", "sorular": [{"id": "h1", "soru": "Kışlık bir palto arıyorum.", "dogru": ["Je cherche un manteau d'hiver."]}, {"id": "h2", "soru": "Hangi beden?", "dogru": ["Quelle taille ?"]}, {"id": "h3", "soru": "Deneyebilir miyim?", "dogru": ["Est-ce que je peux essayer ?", "Je peux essayer ?"]}, {"id": "h4", "soru": "Kabinler nerede?", "dogru": ["Où sont les cabines ?"]}, {"id": "h5", "soru": "Il est ___ petit, je ne peux pas le porter.", "secenekler": ["très", "trop"], "dogru": 1}, {"id": "h6", "soru": "Il est ___ beau, je l'adore !", "secenekler": ["très", "trop"], "dogru": 0}, {"id": "h7", "soru": "Bu ceket fazla pahalı.", "dogru": ["Cette veste est trop chère."]}, {"id": "h8", "soru": "İndirimde. (il)", "dogru": ["Il est en solde."]}, {"id": "h9", "soru": "Alıyorum. (il → le)", "dogru": ["Je le prends."]}, {"id": "h10", "soru": "Bere takmak gerekiyor. (il faut)", "dogru": ["Il faut porter une tuque."]}]}, {"id": "i", "tip": "kisa", "ad": "I. Büyük tablo: birini anlat", "tr": "Fransızca yaz", "talimat": "Ünitenin hepsini birleştir. Her cümlede fiil olsun.", "sorular": [{"id": "i1", "soru": "Kocam uzun boylu, kısa saçlı ve çok sakin.", "dogru": ["Mon mari est grand, il a les cheveux courts et il est très calme."]}, {"id": "i2", "soru": "Bugün siyah bir pantolon ve beyaz bir gömlek giyiyor. (il)", "dogru": ["Aujourd'hui, il porte un pantalon noir et une chemise blanche."]}, {"id": "i3", "soru": "Kız kardeşim benden daha genç ve daha konuşkan.", "dogru": ["Ma sœur est plus jeune et plus bavarde que moi."]}, {"id": "i4", "soru": "Küçük, kırmızı bir arabam var.", "dogru": ["J'ai une petite voiture rouge."]}, {"id": "i5", "soru": "Kanadalı arkadaşım (kadın) çok sevimli.", "dogru": ["Mon amie canadienne est très sympathique.", "Mon amie canadienne est très sympa."], "aciklama": "amie ünlüyle: mon amie"}, {"id": "i6", "soru": "Hava soğuk; paltonu ve eldivenlerini giy! (tu)", "dogru": ["Il fait froid : mets ton manteau et tes gants !", "Il fait froid, mets ton manteau et tes gants !"]}, {"id": "i7", "soru": "Yeşil gözlü, kızıl saçlı bir kadın (une femme aux…)", "dogru": ["une femme aux yeux verts et aux cheveux roux"], "aciklama": "aux + saç/göz = …lı (bonus kalıp)"}, {"id": "i8", "soru": "Bu palto öbürü kadar güzel ama daha ucuz.", "dogru": ["Ce manteau est aussi beau que l'autre, mais il est moins cher."]}]}], "sesIndex": {}}