{"id": "u06-calisma", "baslik": "Ünite 6 · Çalışma kitabı", "unite": 6, "sira": 62, "aciklama": "Puansız alıştırmalar (A–J): geçmiş zaman (avoir + ortaç), zaman kelimeleri, sağlık; anında düzeltme.", "aciklama_uzun": "Bu **çalışma kitabı** puanlanmaz ve teslim edilmez. **Cevapları kontrol et** deyince doğrusu ve nedeni çıkar. Aksan eksikliği hata sayılmaz.", "tur": "alistirma", "bolumler": [{"id": "a", "tip": "kisa", "ad": "A. Ünite 5'ten kalanlar", "tr": "Karışık", "talimat": "1–3: olumsuz yap. 4–6: vouloir mu pouvoir mu? 7–8: soruyu kur.", "sorular": [{"id": "a1", "soru": "Je bois du lait. → olumsuz", "dogru": ["Je ne bois pas de lait."]}, {"id": "a2", "soru": "Il aime les pommes. → olumsuz", "dogru": ["Il n'aime pas les pommes."], "aciklama": "aimer: les kalır."}, {"id": "a3", "soru": "Nous avons des enfants. → olumsuz", "dogru": ["Nous n'avons pas d'enfants."], "aciklama": "de + sesli → d'."}, {"id": "a4", "soru": "___-vous m'aider ? (yardım edebilir misiniz?)", "dogru": ["Pouvez"]}, {"id": "a5", "soru": "Tu ___ un thé ? (ister misin?)", "dogru": ["veux"]}, {"id": "a6", "soru": "Je ne ___ pas venir, je travaille.", "dogru": ["peux"]}, {"id": "a7", "soru": "Où + est-ce que + tu travailles", "dogru": ["Où est-ce que tu travailles ?"]}, {"id": "a8", "soru": "Combien d'enfants + est-ce que + vous avez", "dogru": ["Combien d'enfants est-ce que vous avez ?"]}]}, {"id": "b1", "tip": "kisa", "ad": "B1. avoir'ı yaz", "tr": "Çekim", "talimat": "avoir'ın doğru biçimi (geçmiş zamanın lokomotifi).", "sorular": [{"id": "b1_1", "soru": "j'___ mangé", "dogru": ["ai"]}, {"id": "b1_2", "soru": "tu ___ mangé", "dogru": ["as"]}, {"id": "b1_3", "soru": "il ___ mangé", "dogru": ["a"]}, {"id": "b1_4", "soru": "nous ___ mangé", "dogru": ["avons"]}, {"id": "b1_5", "soru": "vous ___ mangé", "dogru": ["avez"]}, {"id": "b1_6", "soru": "ils ___ mangé", "dogru": ["ont"]}]}, {"id": "b2", "tip": "kisa", "ad": "B2. Hangi zaman?", "tr": "Seç", "talimat": "Şimdi mi, yakın gelecek mi, geçmiş mi?", "sorular": [{"id": "b2_1", "soru": "Nous avons regardé la télé.", "secenekler": ["Şimdi", "Yakın gelecek", "Geçmiş"], "dogru": 2}, {"id": "b2_2", "soru": "Je vais travailler demain.", "secenekler": ["Şimdi", "Yakın gelecek", "Geçmiş"], "dogru": 1}, {"id": "b2_3", "soru": "Il parle avec Marc.", "secenekler": ["Şimdi", "Yakın gelecek", "Geçmiş"], "dogru": 0}, {"id": "b2_4", "soru": "Elles ont acheté du pain.", "secenekler": ["Şimdi", "Yakın gelecek", "Geçmiş"], "dogru": 2}, {"id": "b2_5", "soru": "Tu vas manger ?", "secenekler": ["Şimdi", "Yakın gelecek", "Geçmiş"], "dogru": 1}, {"id": "b2_6", "soru": "J'ai fini.", "secenekler": ["Şimdi", "Yakın gelecek", "Geçmiş"], "dogru": 2}]}, {"id": "c1", "tip": "kisa", "ad": "C1. -er ortaçları", "tr": "Ortaçı yaz", "talimat": "-er'i sil, -é koy.", "sorular": [{"id": "c1_1", "soru": "jouer", "dogru": ["joué"]}, {"id": "c1_2", "soru": "préparer", "dogru": ["préparé"]}, {"id": "c1_3", "soru": "aimer", "dogru": ["aimé"]}, {"id": "c1_4", "soru": "chercher", "dogru": ["cherché"]}, {"id": "c1_5", "soru": "écouter", "dogru": ["écouté"]}, {"id": "c1_6", "soru": "téléphoner", "dogru": ["téléphoné"]}]}, {"id": "c2", "tip": "kisa", "ad": "C2. Geçmişe çevir", "tr": "avoir + ortaç", "talimat": "Geçmişe çevir.", "sorular": [{"id": "c2_1", "soru": "Je parle avec Marc.", "dogru": ["J'ai parlé avec Marc."]}, {"id": "c2_2", "soru": "Nous mangeons au restaurant.", "dogru": ["Nous avons mangé au restaurant."]}, {"id": "c2_3", "soru": "Elle achète du pain.", "dogru": ["Elle a acheté du pain."]}, {"id": "c2_4", "soru": "Ils regardent un film.", "dogru": ["Ils ont regardé un film."]}, {"id": "c2_5", "soru": "Tu travailles samedi ?", "dogru": ["Tu as travaillé samedi ?"]}]}, {"id": "d1", "tip": "kisa", "ad": "D1. Düzensiz ortaçlar", "tr": "Ortaçı yaz", "talimat": "Ortaçı yaz. Aileler: -u (eu, bu, lu, vu), -is (pris, mis), -it (fait, écrit), été.", "sorular": [{"id": "d1_1", "soru": "faire", "dogru": ["fait"]}, {"id": "d1_2", "soru": "prendre", "dogru": ["pris"], "aciklama": "✗ prendu"}, {"id": "d1_3", "soru": "voir", "dogru": ["vu"]}, {"id": "d1_4", "soru": "boire", "dogru": ["bu"]}, {"id": "d1_5", "soru": "lire", "dogru": ["lu"]}, {"id": "d1_6", "soru": "écrire", "dogru": ["écrit"]}, {"id": "d1_7", "soru": "être", "dogru": ["été"]}, {"id": "d1_8", "soru": "avoir", "dogru": ["eu"]}, {"id": "d1_9", "soru": "finir", "dogru": ["fini"]}, {"id": "d1_10", "soru": "attendre", "dogru": ["attendu"]}, {"id": "d1_11", "soru": "dormir", "dogru": ["dormi"]}, {"id": "d1_12", "soru": "mettre", "dogru": ["mis"]}]}, {"id": "d2", "tip": "kisa", "ad": "D2. Fiili geçmişte yaz", "tr": "avoir + ortaç", "talimat": "avoir + ortaç (iki kelime) yaz.", "sorular": [{"id": "d2_1", "soru": "Hier, j'___ (faire) les courses.", "dogru": ["ai fait"]}, {"id": "d2_2", "soru": "Nous ___ (prendre) le bus.", "dogru": ["avons pris"]}, {"id": "d2_3", "soru": "Tu ___ (voir) le film ?", "dogru": ["as vu"]}, {"id": "d2_4", "soru": "Elle ___ (boire) un café.", "dogru": ["a bu"]}, {"id": "d2_5", "soru": "Ils ___ (attendre) le médecin.", "dogru": ["ont attendu"]}, {"id": "d2_6", "soru": "J'___ (être) malade.", "dogru": ["ai été"]}]}, {"id": "e", "tip": "kisa", "ad": "E. Geçmişte olumsuz", "tr": "Olumsuz yap", "talimat": "ne + avoir + pas + ortaç. Artikellere dikkat: un / du / de l' → de; le kalır.", "sorular": [{"id": "e1", "soru": "J'ai mangé une pomme.", "dogru": ["Je n'ai pas mangé de pomme."]}, {"id": "e2", "soru": "Il a fini son travail.", "dogru": ["Il n'a pas fini son travail."]}, {"id": "e3", "soru": "Nous avons acheté du lait.", "dogru": ["Nous n'avons pas acheté de lait."]}, {"id": "e4", "soru": "Elles ont aimé le film.", "dogru": ["Elles n'ont pas aimé le film."], "aciklama": "aimer → le kalır."}, {"id": "e5", "soru": "Tu as pris un médicament.", "dogru": ["Tu n'as pas pris de médicament."]}, {"id": "e6", "soru": "J'ai bu de l'eau.", "dogru": ["Je n'ai pas bu d'eau."]}]}, {"id": "f", "tip": "kisa", "ad": "F. Geçmişte soru", "tr": "Soruyu yaz", "talimat": "Cevaba bak, soruyu yaz. Parantezdeki kelimeyle başla.", "sorular": [{"id": "f1", "soru": "J'ai mangé une pizza. (Qu'est-ce que…)", "dogru": ["Qu'est-ce que tu as mangé ?"]}, {"id": "f2", "soru": "Nous avons mangé au restaurant. (Où…)", "dogru": ["Où est-ce que vous avez mangé ?"], "aciklama": "Cevap nous → soru vous."}, {"id": "f3", "soru": "J'ai payé vingt dollars. (Combien…)", "dogru": ["Combien est-ce que tu as payé ?", "Combien as-tu payé ?"]}, {"id": "f4", "soru": "Marc a téléphoné. (Qui…)", "dogru": ["Qui a téléphoné ?"]}, {"id": "f5", "soru": "Oui, j'ai fini. (Est-ce que…)", "dogru": ["Est-ce que tu as fini ?"]}]}, {"id": "g1", "tip": "kisa", "ad": "G1. Zaman kelimeleri", "tr": "Türkçesini yaz", "talimat": "Türkçesini yaz.", "sorular": [{"id": "g1_1", "soru": "hier soir", "dogru": ["dün akşam"]}, {"id": "g1_2", "soru": "la semaine dernière", "dogru": ["geçen hafta"]}, {"id": "g1_3", "soru": "il y a trois jours", "dogru": ["üç gün önce"]}, {"id": "g1_4", "soru": "avant-hier", "dogru": ["evvelsi gün", "önceki gün"]}]}, {"id": "g2", "tip": "kisa", "ad": "G2. Zarfın yeri", "tr": "Cümleyi yaz", "talimat": "Kısa zarf avoir ile ortaç arasına girer.", "sorular": [{"id": "g2_1", "soru": "J'ai dormi. (bien)", "dogru": ["J'ai bien dormi."]}, {"id": "g2_2", "soru": "Nous avons travaillé. (beaucoup)", "dogru": ["Nous avons beaucoup travaillé."]}, {"id": "g2_3", "soru": "Il a mangé. (déjà)", "dogru": ["Il a déjà mangé."]}, {"id": "g2_4", "soru": "Je n'ai pas fini. (encore)", "dogru": ["Je n'ai pas encore fini."]}]}, {"id": "h1", "tip": "kisa", "ad": "H1. avoir mal à", "tr": "à la, au, aux, à l'", "talimat": "Doğru biçimi yaz.", "sorular": [{"id": "h1_1", "soru": "J'ai mal ___ tête.", "dogru": ["à la"]}, {"id": "h1_2", "soru": "J'ai mal ___ ventre.", "dogru": ["au"]}, {"id": "h1_3", "soru": "J'ai mal ___ dents.", "dogru": ["aux"]}, {"id": "h1_4", "soru": "J'ai mal ___ oreille.", "dogru": ["à l'"]}, {"id": "h1_5", "soru": "J'ai mal ___ dos.", "dogru": ["au"]}, {"id": "h1_6", "soru": "J'ai mal ___ jambe.", "dogru": ["à la"]}]}, {"id": "h2", "tip": "kisa", "ad": "H2. depuis mu, il y a mı?", "tr": "Seç", "talimat": "depuis: hâlâ sürüyor (şimdiki zaman). il y a: bitti (geçmiş).", "sorular": [{"id": "h2_1", "soru": "Je tousse ___ trois jours.", "secenekler": ["depuis", "il y a"], "dogru": 0}, {"id": "h2_2", "soru": "J'ai vu le médecin ___ une semaine.", "secenekler": ["depuis", "il y a"], "dogru": 1}, {"id": "h2_3", "soru": "Il a de la fièvre ___ hier.", "secenekler": ["depuis", "il y a"], "dogru": 0}, {"id": "h2_4", "soru": "Nous avons acheté la maison ___ deux ans.", "secenekler": ["depuis", "il y a"], "dogru": 1}]}, {"id": "i", "tip": "kisa", "ad": "I. Çeviri", "tr": "Fransızca yaz", "talimat": "Bütün üniteden.", "sorular": [{"id": "i1", "soru": "Dün akşam bir film izledik.", "dogru": ["Hier soir, nous avons regardé un film.", "Hier soir, on a regardé un film.", "Nous avons regardé un film hier soir."]}, {"id": "i2", "soru": "Kocam bu sabah kahve içmedi.", "dogru": ["Ce matin, mon mari n'a pas bu de café.", "Mon mari n'a pas bu de café ce matin."]}, {"id": "i3", "soru": "Ne zamandan beri başınız ağrıyor?", "dogru": ["Depuis quand est-ce que vous avez mal à la tête ?", "Depuis quand avez-vous mal à la tête ?"]}, {"id": "i4", "soru": "Anahtarlarımı kaybettim!", "dogru": ["J'ai perdu mes clés !"]}, {"id": "i5", "soru": "Hiç poutine yedin mi?", "dogru": ["Est-ce que tu as déjà mangé de la poutine ?", "Tu as déjà mangé de la poutine ?"], "aciklama": "Soruda déjà = hiç, daha önce."}, {"id": "i6", "soru": "Geçen hafta hastaydım, çalışamadım.", "dogru": ["La semaine dernière, j'ai été malade, je n'ai pas pu travailler.", "La semaine dernière, j'étais malade, je n'ai pas pu travailler."]}]}, {"id": "j", "tip": "kisa", "ad": "J. Ünite 5 tekrarı", "tr": "Karışık", "talimat": "Boşluğu doldur ya da istenen biçimi yaz.", "sorular": [{"id": "j1", "soru": "un kilo ___ pommes", "dogru": ["de"]}, {"id": "j2", "soru": "Je voudrais ___ eau, s'il vous plaît.", "dogru": ["de l'"]}, {"id": "j3", "soru": "480'i harfle yaz", "dogru": ["quatre cent quatre-vingts"]}, {"id": "j4", "soru": "Il n'y a pas ___ lait.", "dogru": ["de"]}, {"id": "j5", "soru": "___-vous répéter, s'il vous plaît ?", "dogru": ["Pouvez"]}, {"id": "j6", "soru": "\"Ça fait combien ?\" Türkçesi", "dogru": ["Ne kadar tuttu?", "Ne kadar?", "Toplam ne kadar?", "Kaç para?"]}]}], "sesIndex": {}}