e que ve devrik", "talimat": "Önce est-ce que ile, sonra devrik olarak sor.", "sorular": [{"id": "e1_1", "soru": "Tu parles français. → est-ce que", "dogru": ["Est-ce que tu parles français ?"]}, {"id": "e1_2", "soru": "Tu parles français. → devrik", "dogru": ["Parles-tu français ?"]}, {"id": "e1_3", "soru": "Il travaille aujourd'hui. → est-ce que", "dogru": ["Est-ce qu'il travaille aujourd'hui ?"]}, {"id": "e1_4", "soru": "Il travaille aujourd'hui. → devrik", "dogru": ["Travaille-t-il aujourd'hui ?"], "aciklama": "Sesli + sesli: araya t."}, {"id": "e1_5", "soru": "Vous habitez à Toronto. → est-ce que", "dogru": ["Est-ce que vous habitez à Toronto ?"]}, {"id": "e1_6", "soru": "Vous habitez à Toronto. → devrik", "dogru": ["Habitez-vous à Toronto ?"]}]}, {"id": "e2", "tip": "kisa", "ad": "E2. Fransızca sor", "tr": "Soru kelimeleri", "talimat": "Fransızca sor.", "sorular": [{"id": "e2_1", "soru": "Ne arıyorsun?", "dogru": ["Qu'est-ce que tu cherches ?"]}, {"id": "e2_2", "soru": "Toplantı saat kaçta başlıyor?", "dogru": ["La réunion commence à quelle heure ?", "À quelle heure est-ce que la réunion commence ?", "À quelle heure commence la réunion ?"]}, {"id": "e2_3", "soru": "Ne zaman bitiriyorsun? (est-ce que ile)", "dogru": ["Quand est-ce que tu termines ?"]}]}, {"id": "f", "tip": "kisa", "ad": "F. Sahiplik sıfatları", "tr": "Doğru biçim", "talimat": "Sahibine değil isme bak: eril mi, dişil mi, çoğul mu, sesliyle mi başlıyor?", "sorular": [{"id": "f1", "soru": "___ voiture (benim)", "dogru": ["ma"]}, {"id": "f2", "soru": "___ bureau (benim)", "dogru": ["mon"]}, {"id": "f3", "soru": "___ amie (benim)", "dogru": ["mon"], "aciklama": "Sesliden önce mon."}, {"id": "f4", "soru": "___ enfants (benim)", "dogru": ["mes"]}, {"id": "f5", "soru": "Julie et ___ mari", "dogru": ["son"], "aciklama": "mari eril."}, {"id": "f6", "soru": "Kerem et ___ femme", "dogru": ["sa"], "aciklama": "femme dişil."}, {"id": "f7", "soru": "___ collègues (senin)", "dogru": ["tes"]}, {"id": "f8", "sor