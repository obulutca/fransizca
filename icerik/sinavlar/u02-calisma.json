ir.", "sorular": [{"id": "e2_1", "soru": "Je ___ ingénieur.", "dogru": ["suis"]}, {"id": "e2_2", "soru": "J'___ trente ans.", "dogru": ["ai"], "aciklama": "Yaş → avoir."}, {"id": "e2_3", "soru": "Ils ___ fatigués.", "dogru": ["sont"]}, {"id": "e2_4", "soru": "Ils ___ des enfants.", "dogru": ["ont"]}, {"id": "e2_5", "soru": "Elle ___ faim.", "dogru": ["a"], "aciklama": "faim → avoir."}, {"id": "e2_6", "soru": "Tu ___ marié ?", "dogru": ["es"]}, {"id": "e2_7", "soru": "Tu ___ une voiture ?", "dogru": ["as"]}, {"id": "e2_8", "soru": "Nous ___ froid.", "dogru": ["avons"], "aciklama": "froid (kişi) → avoir."}, {"id": "e2_9", "soru": "Le moteur ___ petit.", "dogru": ["est"]}, {"id": "e2_10", "soru": "Vous ___ quel âge ?", "dogru": ["avez"]}]}, {"id": "f", "tip": "kisa", "ad": "F. Olumsuz (pas de)", "tr": "Olumsuz yap", "talimat": "Olumsuz yap. un / une / des → de; le / la ve être ile değişmez.", "sorular": [{"id": "f1", "soru": "J'ai une voiture.", "dogru": ["Je n'ai pas de voiture."]}, {"id": "f2", "soru": "Il a des enfants.", "dogru": ["Il n'a pas d'enfants."]}, {"id": "f3", "soru": "Nous avons un problème.", "dogru": ["Nous n'avons pas de problème."]}, {"id": "f4", "soru": "Il y a un robot.", "dogru": ["Il n'y a pas de robot."]}, {"id": "f5", "soru": "J'ai la clé.", "dogru": ["Je n'ai pas la clé."], "aciklama": "la değişmez."}, {"id": "f6", "soru": "C'est une machine.", "dogru": ["Ce n'est pas une machine."], "aciklama": "être: une değişmez."}, {"id": "f7", "soru": "Elle a un ordinateur.", "dogru": ["Elle n'a pas d'ordinateur."]}, {"id": "f8", "soru": "Il y a des machines dans l'atelier.", "dogru": ["Il n'y a pas de machines dans l'atelier."]}]}, {"id": "g1", "tip": "kisa", "ad": "G1. Sayıları yazıyla", "tr": "Kelimeyle yaz", "talimat": "Sayıyı kelimeyle yaz.", "sorular": [{"id": "g1_1", "soru": "7", "dogru": ["sept"]}, {"id": "g1_2", "soru": "11", "dogru": ["onze"]}, {"id": "g1_3", "soru": "16", "dogru": ["seize"]}, {"id": "g1_4", "soru": "21", "dogru": ["vingt et un"]}, {"id": "g1_5", "soru": "34", "dogru": ["trente-quatre"]}, {"id": "g1_6", "soru": "45", "dogru": ["quarante-cinq"]}, {"id": "g1_7", "soru": "58", "dogru": ["cinquante-huit"]}, {"id": "g1_8", "soru": "61", "dogru": ["soixante et un"]}, {"id": "g1_9", "soru": "69", "dogru": ["soixante-neuf"]}, {"id": "g1_10", "soru": "17", "dogru": ["dix-sept"]}]}, {"id": "g2", "tip": "kisa", "ad": "G2. Rakamla", "tr": "Rakamla yaz", "talimat": "Rakamla yaz.", "sorular": [{"id": "g2_1", "soru": "quatorze", "dogru": ["14"]}, {"id": "g2_2", "soru": "trente-six", "dogru": ["36"]}, {"id": "g2_3", "soru": "quinze", "dogru": ["15"]}, {"id": "g2_4", "soru": "soixante", "dogru": ["60"]}, {"id": "g2_5", "soru": "cinquante-deux", "dogru": ["52"]}, {"id": "g2_6", "soru": "douze", "dogru": ["12"]}]}, {"id": "g3", "tip": "kisa", "ad": "G3. Yaş", "tr": "Cümle kur", "talimat": "Yaş cümlesi kur (sayıyı kelimeyle yaz).", "sorular": [{"id": "g3_1", "soru": "Julie, 29", "dogru": ["Julie a vingt-neuf ans."]}, {"id": "g3_2", "soru": "Ben, 38", "dogru": ["J'ai trente-huit ans."]}, {"id": "g3_3", "soru": "Kerem, 41", "dogru": ["Kerem a quarante et un ans."]}, {"id": "g3_4", "soru": "\"Kaç yaşındasınız?\" (resmî)", "dogru": ["Quel âge avez-vous ?", "Vous avez quel âge ?"]}]}, {"id": "h", "tip": "kisa", "ad": "H. Il y a", "tr": "Fransızca yaz", "talimat": "Fransızca yaz.", "sorular": [{"id": "h1", "soru": "Ofiste bir bilgisayar var.", "dogru": ["Il y a un ordinateur dans le bureau.", "Il y a un ordinateur au bureau."]}, {"id": "h2", "soru": "Fabrikada üç robot var.", "dogru": ["Il y a trois robots dans l'usine.", "Il y a trois robots à l'usine."]}, {"id": "h3", "soru": "Garajda araba yok.", "dogru": ["Il n'y a pas de voiture dans le garage."]}, {"id": "h4", "soru": "Bir sorun var mı? (est-ce que ile)", "dogru": ["Est-ce qu'il y a un problème ?"]}, {"id": "h5", "soru": "Atölyede iki makine var.", "dogru": ["Il y a deux machines dans l'atelier."]}]}, {"id": "i1", "tip": "kisa", "ad": "I1. Türkçeden çeviri", "tr": "Fransızca yaz", "talimat": "Her cümleden sonra üç soruyu sor: özne kim, fiil uyuyor mu, sıfat uyuyor mu?", "sorular": [{"id": "i1_1", "soru": "Bir erkek kardeşim ve bir kız kardeşim var.", "dogru": ["J'ai un frère et une sœur."]}, {"id": "i1_2", "soru": "Çocuğum yok.", "dogru": ["Je n'ai pas d'enfants.", "Je n'ai pas d'enfant."]}, {"id": "i1_3", "soru": "Julie'nin bir kedisi var.", "dogru": ["Julie a un chat."]}, {"id": "i1_4", "soru": "Acıktım ve susadım.", "dogru": ["J'ai faim et j'ai soif.", "J'ai faim et soif."]}, {"id": "i1_5", "soru": "Kaç yaşındasın?", "dogru": ["Tu as quel âge ?", "Quel âge as-tu ?"]}, {"id": "i1_6", "soru": "Onların (bir kadın ve bir erkek) iki çocuğu var.", "dogru": ["Ils ont deux enfants."], "aciklama": "Karışık grup → ils."}, {"id": "i1_7", "soru": "Bugün fabrikada bir toplantı var.", "dogru": ["Aujourd'hui, il y a une réunion à l'usine.", "Aujourd'hui, il y a une réunion dans l'usine.", "Il y a une réunion à l'usine aujourd'hui."]}, {"id": "i1_8", "soru": "Anahtar bende değil.", "dogru": ["Je n'ai pas la clé."]}, {"id": "i1_9", "soru": "Bu, Julie'nin bilgisayarı.", "dogru": ["C'est l'ordinateur de Julie."]}, {"id": "i1_10", "soru": "Makineler büyük ama motorlar küçük.", "dogru": ["Les machines sont grandes, mais les moteurs sont petits."], "aciklama": "machine dişil → grandes; moteur eril → petits."}]}, {"id": "i2", "tip": "kisa", "ad": "I2. İngilizceden çeviri", "tr": "Fransızca yaz", "talimat": "İngilizceden Fransızcaya çevir.", "sorular": [{"id": "i2_1", "soru": "I am 40.", "dogru": ["J'ai quarante ans."]}, {"id": "i2_2", "soru": "They are cold.", "dogru": ["Ils ont froid."], "aciklama": "be cold → avoir froid."}, {"id": "i2_3", "soru": "There are no robots in the workshop.", "dogru": ["Il n'y a pas de robots dans l'atelier."]}, {"id": "i2_4", "soru": "We have friends in Toronto.", "dogru": ["Nous avons des amis à Toronto.", "On a des amis à Toronto."], "aciklama": "İngilizcede artikel yok, Fransızcada des şart."}]}, {"id": "j", "tip": "kisa", "ad": "J. Hata bulma", "tr": "Doğrusunu yaz", "talimat": "Her cümlede bir hata var. Doğrusunu yaz.", "sorular": [{"id": "j1", "soru": "Je suis trente ans.", "dogru": ["J'ai trente ans."], "aciklama": "Yaş → avoir."}, {"id": "j2", "soru": "Je n'ai pas une voiture.", "dogru": ["Je n'ai pas de voiture."]}, {"id": "j3", "soru": "J'ai amis à Toronto.", "dogru": ["J'ai des amis à Toronto."]}, {"id": "j4", "soru": "Il y a deux problème.", "dogru": ["Il y a deux problèmes."]}, {"id": "j5", "soru": "Le usine est grande.", "dogru": ["L'usine est grande."]}, {"id": "j6", "soru": "Tu a une voiture ?", "dogru": ["Tu as une voiture ?"], "aciklama": "tu → -s."}, {"id": "j7", "soru": "Il y a des bureaus.", "dogru": ["Il y a des bureaux."]}, {"id": "j8", "soru": "La moteur est petit.", "dogru": ["Le moteur est petit."]}]}], "sesIndex": {}}